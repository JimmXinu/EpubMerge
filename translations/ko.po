#: epubmerge_plugin.py:63 epubmerge_plugin.py:554 epubmerge_plugin.py:570
#: epubmerge_plugin.py:681
msgid "EpubMerge"
msgstr "EpubMerge"

#: epubmerge_plugin.py:64
msgid "Merge multiple EPUBs into one in a new book."
msgstr "여러 EPUB를 새 책 하나로 병합합니다."

#: epubmerge_plugin.py:114 epubmerge_plugin.py:115
msgid "&Merge Epubs"
msgstr "EPUB 병합(&M)"

#: epubmerge_plugin.py:118 epubmerge_plugin.py:119
msgid "&UnMerge Epubs"
msgstr "EPUB 병합 해제(&U)"

#: epubmerge_plugin.py:128
msgid "&Configure Plugin"
msgstr "플러그인 설정(&C)"

#: epubmerge_plugin.py:130 epubmerge_plugin.py:131
msgid "Configure EpubMerge"
msgstr "EpubMerge 설정"

#: epubmerge_plugin.py:186
msgid "Cannot UnMerge Non-Epubs"
msgstr "EPUB가 아닌 파일은 분리할 수 없음"

#: epubmerge_plugin.py:187 epubmerge_plugin.py:198
msgid ""
"To UnMerge the source must be Epub(s) created by EpubMerge with Keep UnMerge"
" Metadata enabled."
msgstr "분리하려면 원본이 '분리 메타데이터 유지'가 활성화된 EpubMerge로 생성된 EPUB여야 합니다."

#: epubmerge_plugin.py:197
msgid "No UnMerge data found"
msgstr "분리 데이터가 없습니다"

#: epubmerge_plugin.py:214
msgid ""
"You already have a book <i>%s</i> by <i>%s</i>.  You may Add a new book of "
"the same title, Overwrite the Epub in the existing book, or Discard this "
"Epub."
msgstr "<i>%s</i> / <i>%s</i> 책이 이미 있습니다. 같은 제목의 새 책으로 추가하거나, 기존 책의 Epub를 덮어쓰거나, 이 Epub를 버릴 수 있습니다."

#: epubmerge_plugin.py:217
msgid ""
"You already have more than one book <i>%s</i> by <i>%s</i>.  You may Add a "
"new book of the same title, or Discard this Epub."
msgstr "<i>%s</i> / <i>%s</i> 책이 이미 둘 이상 있습니다. 같은 제목의 새 책으로 추가하거나 이 Epub를 버릴 수 있습니다."

#: epubmerge_plugin.py:257 epubmerge_plugin.py:289 epubmerge_plugin.py:308
msgid "Cannot Merge Epubs"
msgstr "Epub를 병합할 수 없음"

#: epubmerge_plugin.py:258
msgid "No books selected."
msgstr ""

#: epubmerge_plugin.py:290
msgid "%s books failed."
msgstr "%s권 처리 실패."

#: epubmerge_plugin.py:295
msgid "Order EPUBs to Merge"
msgstr "병합할 EPUB 순서"

#: epubmerge_plugin.py:309
msgid "Less than 2 books in merge list."
msgstr ""

#: epubmerge_plugin.py:370 epubmerge_plugin.py:589
msgid "%s by %s"
msgstr "%s / %s"

#: epubmerge_plugin.py:374
msgid "%s containing:"
msgstr "%s 포함:"

#: epubmerge_plugin.py:549
msgid ""
"The book for the new Merged EPUB has been created and default metadata filled in.\n"
"\n"
"However, the EPUB will *not* be created until after you've reviewed, edited, and closed the metadata dialog that follows."
msgstr "새 병합 EPUB용 책이 생성되었고 기본 메타데이터도 채워졌습니다.\n\n하지만 이어지는 메타데이터 대화상자를 확인·편집하고 닫기 전까지 EPUB는 생성되지 않습니다."

#: epubmerge_plugin.py:565
msgid ""
"EpubMerge will be done in a Background job.  The merged EPUB will not appear in the Library until finished.\n"
"\n"
"You are merging %s EPUBs totaling %s."
msgstr "EpubMerge는 백그라운드 작업으로 수행됩니다. 작업이 끝날 때까지 병합 EPUB는 서재에 나타나지 않습니다.\n\n총 %s, %s 분량의 EPUB를 병합합니다."

#: epubmerge_plugin.py:578
msgid "Merging %s EPUBs..."
msgstr "EPUB %s개 병합 중..."

#: epubmerge_plugin.py:621
msgid "EpubMerge: %s"
msgstr "EpubMerge: %s"

#: epubmerge_plugin.py:632
msgid "Starting EpubMerge"
msgstr "EpubMerge 시작"

#: epubmerge_plugin.py:640 epubmerge_plugin.py:646
msgid "Remove Failed Anthology Book?"
msgstr "실패한 작품집 도서를 제거하시겠습니까?"

#: epubmerge_plugin.py:647
msgid ""
"EpubMerge failed, no new EPUB was created; see the background job details "
"for any error messages."
msgstr "EpubMerge 실행에 실패하여 새 EPUB를 만들지 못했습니다. 오류 메시지는 백그라운드 작업 세부 정보에서 확인하십시오."

#: epubmerge_plugin.py:648
msgid "Do you want to delete the empty book EpubMerge created?"
msgstr "EpubMerge가 만든 빈 책을 삭제하시겠습니까?"

#: epubmerge_plugin.py:649
msgid "Click '<b>Yes</b>' to remove empty book from Libary,"
msgstr "빈 책을 서재에서 제거하려면 '<b>예</b>'를 클릭하세요."

#: epubmerge_plugin.py:650
msgid "Click '<b>No</b>' to leave it in Library."
msgstr "서재에 남겨두려면 '<b>아니오</b>'를 클릭하세요."

#: epubmerge_plugin.py:658
msgid ""
"Merge finished, output in:\n"
"%s"
msgstr "병합 완료, 출력 위치:\n%s"

#: epubmerge_plugin.py:670
msgid "Finished merging %s EPUBs."
msgstr "EPUB %s개 병합 완료."

#: epubmerge_plugin.py:678
msgid ""
"EpubMerge has finished. The new EPUB has been added to the book previously "
"created."
msgstr "EpubMerge가 완료되었습니다. 새 EPUB가 미리 생성된 책에 추가되었습니다."

#: epubmerge_plugin.py:735
msgid "%s by %s doesn't have an EPUB."
msgstr "%s / %s 책에는 EPUB가 없습니다."
