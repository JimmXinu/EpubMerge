#: config.py:339
msgid "Take oldest value from source books"
msgstr "Ältesten Wert aus Quellbüchern übernehmen"

#: config.py:340
msgid "Include values from all source books"
msgstr "Werte aus allen Quellbüchern einfügen"

#: config.py:341
