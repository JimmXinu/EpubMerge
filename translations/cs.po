#: __init__.py:48
msgid "UI plugin to concatenate multiple epubs into one."
msgstr "Modul uživatelského rozhraní pro sloučení více EPUBů do jednoho."

#: config.py:51
msgid "Anthology"
msgstr "Antologie"

#: config.py:141
msgid "Basic"
msgstr "Základní"

#: config.py:144
msgid "Columns"
msgstr "Sloupce"

#: config.py:189
msgid "These settings control the basic features of the plugin."
msgstr "Tato nastavení řídí základní funkce modulu."

#: config.py:194
msgid ""
"If both 'Insert Table of Contents entry' and 'Copy Table of Contents entries'\n"
"are unchecked, there will be no Table of Contents in merged books."
msgstr "Pokud nejsou zaškrtnuty volby „Vložit položku obsahu“ ani\n„Kopírovat položky obsahu“, sloučené knihy nebudou mít žádný obsah."

#: config.py:196
msgid "Insert Table of Contents entry for each title?"
msgstr "Vložit položku obsahu pro každý titul?"

#: config.py:197
msgid ""
"If set, a new TOC entry will be made for each title and\n"
"it's existing TOC nested underneath it."
msgstr "Pokud je tato volba nastavena, pro každý titul bude vytvořena\nnová položka obsahu a jeho stávající obsah bude vnořen pod ni."

#: config.py:202
msgid "Copy Table of Contents entries from each title?"
msgstr "Kopírovat položky obsahu z každého titulu?"

#: config.py:203
msgid "If set, the original TOC entries will be included the new epub."
msgstr "Pokud je tato volba nastavena, původní položky obsahu budou zahrnuty do nového EPUBu."

#: config.py:217
msgid "Skip when there is only one TOC entry?"
msgstr "Přeskočit, když existuje jen jedna položka obsahu?"

#: config.py:218
msgid ""
"If set, the original TOC entries for each book will only be included\n"
"if there's more than TOC entry one in that book."
msgstr "Pokud je tato volba nastavena, původní položky obsahu každé knihy\nbudou zahrnuty jen tehdy, když je v dané knize více než jedna položka obsahu."

#: config.py:230
msgid "Flatten Table of Contents?"
msgstr "Zploštit obsah?"

#: config.py:231
msgid "Remove nesting and make TOC all on one level."
msgstr "Odstranit vnoření a převést celý obsah do jedné úrovně."

#: config.py:235
msgid "Include Books' Comments?"
msgstr "Zahrnout komentáře knih?"

#: config.py:236
msgid ""
"Include all the merged books' comments in the new book's comments.\n"
"Default is a list of included titles only."
msgstr "Zahrnout komentáře všech sloučených knih do komentářů nové knihy.\nVýchozí je pouze seznam zahrnutých titulů."

#: config.py:241
msgid "Keep UnMerge Metadata?"
msgstr "Zachovat metadata pro zpětné rozdělení?"

#: config.py:242
msgid ""
"If set, a copy of the original metadata for each merged book will\n"
"be included, allowing for UnMerge.  This includes your calibre custom\n"
"columns.  Leave off if you plan to distribute the epub to others."
msgstr "Pokud je tato volba nastavena, bude zahrnuta kopie původních metadat\nkaždé sloučené knihy, což umožní zpětné rozdělení. Patří sem i vlastní\nsloupce calibre. Pokud plánujete EPUB distribuovat dalším lidem, nechte\ntuto volbu vypnutou."

#: config.py:248
msgid "Restore Selection?"
msgstr "Obnovit výběr?"

#: config.py:249
msgid ""
"If set, the plugin will select the same books again after starting\n"
"the merge.  Default behavior is to select the new merge book."
msgstr "Pokud je tato volba nastavena, modul po zahájení sloučení znovu\nvybere stejné knihy. Výchozím chováním je vybrat novou sloučenou knihu."

#: config.py:261
msgid "Add tags to merged books:"
msgstr "Přidat štítky ke sloučeným knihám:"

#: config.py:265
msgid "Tags you enter here will be added to all new merged books"
msgstr "Štítky, které zde zadáte, budou přidány ke všem novým sloučeným knihám"

#: config.py:270
msgid "Merged Book Word:"
msgstr "Slovo pro sloučenou knihu:"

#: config.py:274
msgid ""
"Word use to describe merged books in default title and summary.\n"
"For people who don't like the word Anthology."
msgstr "Slovo používané k označení sloučených knih ve výchozím názvu a souhrnu.\nPro uživatele, kterým se nelíbí slovo Antologie."

#: config.py:283
msgid ""
"These controls aren't plugin settings as such, but convenience buttons for "
"setting Keyboard shortcuts and getting all the EpubMerge confirmation "
"dialogs back again."
msgstr "Tyto ovládací prvky nejsou nastaveními modulu jako takovými, ale praktickými tlačítky pro nastavení klávesových zkratek a opětovné zobrazení všech potvrzovacích dialogů EpubMerge."

#: config.py:288
msgid "Keyboard shortcuts..."
msgstr "Klávesové zkratky..."

#: config.py:289
msgid "Edit the keyboard shortcuts associated with this plugin"
msgstr "Upravit klávesové zkratky přiřazené tomuto modulu"

#: config.py:293
msgid "Reset disabled &confirmation dialogs"
msgstr "Resetovat zakázané &potvrzovací dialogy"

#: config.py:294
msgid "Reset all show me again dialogs for the EpubMerge plugin"
msgstr "Resetovat všechny dialogy „zobrazit znovu“ modulu EpubMerge"

#: config.py:298
msgid "View library preferences..."
msgstr "Zobrazit předvolby knihovny..."

#: config.py:299
msgid "View data stored in the library database for this plugin"
msgstr "Zobrazit data tohoto modulu uložená v databázi knihovny"

#: config.py:314
msgid "Done"
msgstr "Hotovo"

#: config.py:315
msgid "Confirmation dialogs have all been reset"
msgstr "Všechny potvrzovací dialogy byly resetovány"

#: config.py:331
msgid "Take value from first source book"
msgstr "Vzít hodnotu z první zdrojové knihy"

#: config.py:332
msgid "Take value from last source book"
msgstr "Vzít hodnotu z poslední zdrojové knihy"

#: config.py:333
msgid "Add values from all source books"
msgstr "Sečíst hodnoty ze všech zdrojových knih"

#: config.py:334
msgid "Average value from ALL source books"
msgstr "Průměrná hodnota ze VŠECH zdrojových knih"

#: config.py:335
msgid "Average value from source books with values"
msgstr "Průměrná hodnota ze zdrojových knih s hodnotami"

#: config.py:336
msgid "True if true on all source books (and)"
msgstr "Pravda, pokud je hodnota pravdivá u všech zdrojových knih (and)"

#: config.py:337
msgid "True if true on any source books (or)"
msgstr "Pravda, pokud je hodnota pravdivá u alespoň jedné zdrojové knihy (or)"

#: config.py:338
msgid "Take newest value from source books"
msgstr "Vzít nejnovější hodnotu ze zdrojových knih"

#: config.py:339
msgid "Take oldest value from source books"
msgstr "Vzít nejstarší hodnotu ze zdrojových knih"

#: config.py:340
msgid "Include values from all source books"
msgstr "Zahrnout hodnoty ze všech zdrojových knih"

#: config.py:341
msgid "Concatenate values from all source books"
msgstr "Zřetězit hodnoty ze všech zdrojových knih"

#: config.py:342
msgid "Set to current time when created"
msgstr "Nastavit při vytvoření na aktuální čas"

#: config.py:355
msgid "Standard Columns:"
msgstr "Standardní sloupce:"

#: config.py:360
msgid "Take Series from first book"
msgstr "Vzít sérii z první knihy"

#: config.py:361
msgid ""
"If set, the Series name and index from the first book will be set on the "
"merged book."
msgstr "Pokud je tato volba nastavena, u sloučené knihy bude nastaven název série a index série z první knihy."

#: config.py:366
msgid "Custom Columns:"
msgstr "Vlastní sloupce:"

#: config.py:369
msgid ""
"If you have custom columns defined, they will be listed below.  Choose how "
"you would like these columns handled."
msgstr "Pokud máte definované vlastní sloupce, budou uvedeny níže. Zvolte, jak se mají tyto sloupce zpracovat."

#: config.py:395
msgid "Set this %s column on new merged books..."
msgstr "Nastavit tento sloupec typu %s u nových sloučených knih..."

#: config.py:410
msgid "How this column will be populated by default."
msgstr "Jak bude tento sloupec ve výchozím stavu vyplněn."

#: dialogs.py:51 dialogs.py:75
msgid "Starting..."
msgstr "Spouštění..."

#: dialogs.py:52 dialogs.py:76
msgid "Working"
msgstr "Zpracování"

#: dialogs.py:53 dialogs.py:77
msgid "Completed so far"
msgstr "Dosud dokončeno"

#: dialogs.py:80
msgid "Cancel"
msgstr "Zrušit"

#: dialogs.py:121
msgid "Starting Merge..."
msgstr "Zahajuje se sloučení..."

#: dialogs.py:164 epubmerge_plugin.py:174
msgid "Select Merge Target"
msgstr "Vybrat cíl sloučení"

#: dialogs.py:217
msgid "Move selected books up the list"
msgstr "Přesunout vybrané knihy v seznamu nahoru"

#: dialogs.py:222
msgid "Remove selected books from the list"
msgstr "Odebrat vybrané knihy ze seznamu"

#: dialogs.py:227
msgid "Move selected books down the list"
msgstr "Přesunout vybrané knihy v seznamu dolů"

#: dialogs.py:232
msgid "Add EPUBs from PC..."
msgstr "Přidat soubory EPUB z počítače..."

#: dialogs.py:265 dialogs.py:266 dialogs.py:267 epubmerge_plugin.py:170
#: epubmerge_plugin.py:206 epubmerge_plugin.py:207 epubmerge_plugin.py:208
#: epubmerge_plugin.py:222 epubmerge_plugin.py:867 epubmerge_plugin.py:868
#: epubmerge_plugin.py:869
msgid "Unknown"
msgstr "Neznámý"

#: dialogs.py:299
msgid "Error reading files"
msgstr "Chyba čtení souborů"

#: dialogs.py:300
msgid "Could not read metadata from the following files:<br><br>%s"
msgstr "Nepodařilo se načíst metadata z následujících souborů:<br><br>%s"

#: dialogs.py:306
msgid "Choose EPUB files to merge"
msgstr "Zvolte soubory EPUB ke sloučení"

#: dialogs.py:307
msgid "EPUB files"
msgstr "Soubory EPUB"

#: dialogs.py:325 epubmerge_plugin.py:237 epubmerge_plugin.py:359
msgid "Collecting EPUBs for merger..."
msgstr "Shromažďují se EPUBy ke sloučení..."

#: dialogs.py:326 epubmerge_plugin.py:238 epubmerge_plugin.py:360
msgid "Get EPUBs for merge"
msgstr "Získávání EPUBů ke sloučení"

#: dialogs.py:327 epubmerge_plugin.py:239 epubmerge_plugin.py:361
msgid "EPUBs collected"
msgstr "Shromážděné EPUBy"

#: dialogs.py:343
msgid "Author(s)"
msgstr "Autor/autoři"

#: dialogs.py:343
msgid "Series"
msgstr "Série"

#: dialogs.py:343
msgid "Title"
msgstr "Název"

#: dialogs.py:393
msgid "Are you sure you want to remove this book from the list?"
msgstr "Opravdu chcete tuto knihu odebrat ze seznamu?"

#: dialogs.py:395
msgid "Are you sure you want to remove the selected %d books from the list?"
msgstr "Opravdu chcete odebrat vybrané knihy ze seznamu? Počet: %d"

#: dialogs.py:468
msgid "UnMerge Epub"
msgstr "Zpětně rozdělit EPUB"

#: dialogs.py:475
msgid "Apply to all EPUBs?"
msgstr "Použít pro všechny EPUBy?"

#: dialogs.py:476
msgid "Apply the same action to the rest of the EPUBs after this."
msgstr "Poté použít stejnou akci pro zbývající EPUBy."

#: dialogs.py:480
msgid "Add"
msgstr "Přidat"

#: dialogs.py:484
msgid "Overwrite"
msgstr "Přepsat"

#: dialogs.py:487
msgid "Discard"
msgstr "Zahodit"

#: epubmerge_plugin.py:63 epubmerge_plugin.py:485 epubmerge_plugin.py:502
#: epubmerge_plugin.py:695 epubmerge_plugin.py:711 epubmerge_plugin.py:856
msgid "EpubMerge"
msgstr "EpubMerge"

#: epubmerge_plugin.py:64
msgid "Merge multiple EPUBs into one in a new book."
msgstr "Sloučit více EPUBů do jednoho v nové knize."

#: epubmerge_plugin.py:114 epubmerge_plugin.py:115
msgid "&Merge Epubs"
msgstr "&Sloučit EPUBy"

#: epubmerge_plugin.py:118 epubmerge_plugin.py:119
msgid "&Merge into Existing Epub"
msgstr "Sloučit do &existujícího EPUBu"

#: epubmerge_plugin.py:122 epubmerge_plugin.py:123
msgid "&UnMerge Epubs"
msgstr "&Zpětně rozdělit EPUBy"

#: epubmerge_plugin.py:129
msgid "&Configure Plugin"
msgstr "&Konfigurovat modul"

#: epubmerge_plugin.py:131 epubmerge_plugin.py:132
msgid "Configure EpubMerge"
msgstr "Konfigurovat EpubMerge"

#: epubmerge_plugin.py:158 epubmerge_plugin.py:338 epubmerge_plugin.py:370
#: epubmerge_plugin.py:389
msgid "Cannot Merge Epubs"
msgstr "Nelze sloučit EPUBy"

#: epubmerge_plugin.py:159 epubmerge_plugin.py:339
msgid "No books selected."
msgstr "Nejsou vybrány žádné knihy."

#: epubmerge_plugin.py:267
msgid "Cannot UnMerge Non-Epubs"
msgstr "Knihy bez EPUBu nelze zpětně rozdělit"

#: epubmerge_plugin.py:268 epubmerge_plugin.py:279
msgid ""
"To UnMerge the source must be Epub(s) created by EpubMerge with Keep UnMerge"
" Metadata enabled."
msgstr "Pro zpětné rozdělení musí být zdrojem EPUB vytvořený modulem EpubMerge se zapnutou volbou Zachovat metadata pro zpětné rozdělení."

#: epubmerge_plugin.py:278
msgid "No UnMerge data found"
msgstr "Nebyla nalezena data pro zpětné rozdělení"

#: epubmerge_plugin.py:295
msgid ""
"You already have a book <i>%s</i> by <i>%s</i>.  You may Add a new book of "
"the same title, Overwrite the Epub in the existing book, or Discard this "
"Epub."
msgstr "V knihovně už máte knihu <i>%s</i> od <i>%s</i>. Můžete přidat novou knihu se stejným názvem, přepsat EPUB v existující knize, nebo tento EPUB zahodit."

#: epubmerge_plugin.py:298
msgid ""
"You already have more than one book <i>%s</i> by <i>%s</i>.  You may Add a "
"new book of the same title, or Discard this Epub."
msgstr "V knihovně už máte více než jednu knihu <i>%s</i> od <i>%s</i>. Můžete přidat novou knihu se stejným názvem, nebo tento EPUB zahodit."

#: epubmerge_plugin.py:371
msgid "%s books failed."
msgstr "Počet knih, u kterých došlo k chybě: %s."

#: epubmerge_plugin.py:376
msgid "Order EPUBs to Merge"
msgstr "Seřadit EPUBy ke sloučení"

#: epubmerge_plugin.py:390
msgid "Less than 2 books in merge list."
msgstr "Seznam ke sloučení obsahuje méně než dvě knihy."

#: epubmerge_plugin.py:451 epubmerge_plugin.py:730
msgid "%s by %s"
msgstr "%s od %s"

#: epubmerge_plugin.py:455
msgid "%s containing:"
msgstr "%s obsahuje:"

#: epubmerge_plugin.py:480
msgid ""
"Are you sure you want to overwrite the existing EPUB in book <i>%s</i>?<br><br>\n"
"\n"
"This will replace the current EPUB file."
msgstr "Opravdu chcete přepsat existující EPUB v knize <i>%s</i>?<br><br>\n\nTím se nahradí aktuální soubor EPUB."

#: epubmerge_plugin.py:495
msgid ""
"Do you want to save a backup of the existing EPUB as ORIGINAL_EPUB  <i>%s</i>?<br><br>\n"
"\n"
"If converting to another format using Calibre and want to use the new EPUB, you will need to manually remove the ORIGINAL_EPUB file.<br><br>\n"
"\n"
"If you choose not to save a backup, you may still see it in the metadata confirm change screen, but it will be deleted once merging is complete."
msgstr "Chcete zálohu existujícího EPUBu uložit jako ORIGINAL_EPUB pro knihu <i>%s</i>?\n\nPokud při převodu v calibre do jiného formátu chcete použít nový EPUB, bude nutné soubor ORIGINAL_EPUB odstranit ručně.\n\nPokud se rozhodnete zálohu neukládat, může se ještě zobrazit na obrazovce potvrzení změn metadat, po dokončení slučování však bude odstraněna."

#: epubmerge_plugin.py:690
msgid ""
"The book for the new Merged EPUB has been created and default metadata filled in.\n"
"\n"
"However, the EPUB will *not* be created until after you've reviewed, edited, and closed the metadata dialog that follows."
msgstr "Kniha pro nový sloučený EPUB byla vytvořena a výchozí metadata byla vyplněna.\n\nEPUB však *nebude* vytvořen, dokud nezkontrolujete, neupravíte a nezavřete následující dialog metadat."

#: epubmerge_plugin.py:706
msgid ""
"EpubMerge will be done in a Background job.  The merged EPUB will not appear in the Library until finished.\n"
"\n"
"You are merging %s EPUBs totaling %s."
msgstr "EpubMerge proběhne jako úloha na pozadí. Sloučený EPUB se v knihovně objeví až po dokončení.\n\nSlučujete %s EPUBů o celkové velikosti %s."

#: epubmerge_plugin.py:719
msgid "Merging %s EPUBs..."
msgstr "Slučuje se %s EPUBů..."

#: epubmerge_plugin.py:766
msgid "EpubMerge: %s"
msgstr "EpubMerge: %s"

#: epubmerge_plugin.py:777
msgid "Starting EpubMerge"
msgstr "Spouští se EpubMerge"

#: epubmerge_plugin.py:800
msgid "Merge Overwrite Failed"
msgstr "Sloučení s přepsáním selhalo"

#: epubmerge_plugin.py:801
msgid ""
"The merge background job failed. Your existing book entry and its original "
"EPUB format have been automatically restored to their original state."
msgstr "Úloha na pozadí pro sloučení selhala. Záznam existující knihy i její původní formát EPUB byly automaticky obnoveny do původního stavu."

#: epubmerge_plugin.py:804 epubmerge_plugin.py:810
msgid "Remove Failed Anthology Book?"
msgstr "Odebrat neúspěšně vytvořenou sloučenou knihu?"

#: epubmerge_plugin.py:811
msgid ""
"EpubMerge failed, no new EPUB was created; see the background job details "
"for any error messages."
msgstr "EpubMerge selhal, nebyl vytvořen žádný nový EPUB; případné chybové zprávy najdete v podrobnostech úlohy na pozadí."

#: epubmerge_plugin.py:812
msgid "Do you want to delete the empty book EpubMerge created?"
msgstr "Chcete odstranit prázdnou knihu, kterou EpubMerge vytvořil?"

#: epubmerge_plugin.py:813
msgid "Click '<b>Yes</b>' to remove empty book from Libary,"
msgstr "Kliknutím na „<b>Ano</b>“ odeberete prázdnou knihu z knihovny,"

#: epubmerge_plugin.py:814
msgid "Click '<b>No</b>' to leave it in Library."
msgstr "Kliknutím na „<b>Ne</b>“ ji ponecháte v knihovně."

#: epubmerge_plugin.py:822
msgid ""
"Merge finished, output in:\n"
"%s"
msgstr "Sloučení dokončeno, výstup je v:\n%s"

#: epubmerge_plugin.py:840
msgid "Finished merging %s EPUBs."
msgstr "Slučování %s EPUBů dokončeno."

#: epubmerge_plugin.py:853
msgid ""
"EpubMerge has finished. The new EPUB has been added to the book previously "
"created."
msgstr "EpubMerge dokončil práci. Nový EPUB byl přidán do dříve vytvořené knihy."

#: epubmerge_plugin.py:910
msgid "%s by %s doesn't have an EPUB."
msgstr "Kniha %s od %s nemá EPUB."
